{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
        "os": "#ACB0BE",
        "pink": "#F5BDE6",
        "lavender": "#B7BDF8",
        "blue":  "#8AADF4",
        "wight": "#FFFFFF",
        "mauve": "#CA9EE6",
        "text": "#494D64"
  },
  "blocks": [
    {
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "{{}}"
        }
      ]
    },
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:blue",
          "foreground": "p:text",
          "style": "diamond",
          "trailing_diamond": "\ue0b0",
          "template": " {{ .UserName }} ",
          "type": "session"
        },
        {
          "background": "p:pink",
          "foreground": "p:text",
          "options": {
            "folder_icon": "..\ue5fe..",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "trailing_diamond": "\ue0b0",
          "leading_diamond": "<transparent>\ue0b0</>",
          "style": "diamond",
          "template": " {{ .Path }} ",
          "type": "path"
        },
        {
          "type": "shell",
          "style": "diamond",
          "trailing_diamond": "\ue0b0",
          "background": "p:mauve",
          "foreground": "p:text",
          "options": {
            "mapped_shell_names": {
              "zsh": ""
            }
          }
        },
        {
          "background": "p:lavender",
          "foreground": "p:text",
          "style": "diamond",
          "options": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "trailing_diamond": "\ue0b0",
          "template": " {{ .HEAD }}",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "type": "rprompt",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "invert_powerline": true,
          "leading_diamond": "\ue0b2",
          "foreground": "p:text",
          "background": "p:lavender",
          "template": " {{ .FormattedMs }} ",
          "options": {
            "threshold": 500,
            "style": "round",
            "always_enabled": false
          }
        },
        {
          "type": "status",
          "style": "diamond",
          "foreground": "p:text",
          "background": "p:mauve",
          "background_templates": [
            "{{ if .Error }}#e91e63{{ end }}"
          ],
          "foreground_templates": [
            "{{ if .Error }}p:wight{{ end }}"
          ],
          "leading_diamond": "\ue0b2",
          "template": "{{ if .Error }} {{.String}} {{ end }}{{ if not .Error }} :3 {{ end }}",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ],
  "final_space": true,
  "version": 4,
  "cursor_style": "steady_block"
}
